# Chroma Cloud (from dashboard → Connect)
CHROMA_API_KEY=ck-your-api-key
CHROMA_TENANT=your-tenant-id
CHROMA_DATABASE=your-database-name
# Uncomment if your database is outside us-east-1:
# CHROMA_HOST=europe-west1.gcp.trychroma.com

# RAG pipeline
RAG_PDF_DIR=data/pdf
RAG_VECTOR_DIR=data/vector_store
RAG_COLLECTION=pdf_documents
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
